@page
@model IndexModel
@{
    ViewData["Title"] = "Login";
}

@if (!Model.EstaLogueado)
{
    <div class="container mt-5" style="max-width: 450px;">
        <h3 class="text-center mb-4">Inicio de Sesión</h3>

        <form method="POST">
            <div class="form-group mb-3">
                <label class="control-label fw-bold">Usuario</label>
                <input asp-for="@Model.Usuario"
                       class="form-control"
                       placeholder="Ingresa tu usuario"
                       autocomplete="off" />
            </div>

            <div class="form-group mb-4">
                <label class="control-label fw-bold">Contraseña</label>
                <input asp-for="@Model.Contrasena"
                       type="password"
                       class="form-control"
                       placeholder="********" />
            </div>

            <div class="d-flex justify-content-between">
                <input type="submit"
                       value="Limpiar"
                       asp-page-handler="BtClean"
                       class="btn btn-secondary px-4" />

                <input type="submit"
                       value="Entrar"
                       asp-page-handler="BtEnter"
                       class="btn btn-primary px-4" />
            </div>
        </form>
    </div>
}
else
{
    <div class="container text-center mt-5">
        <h1 class="display-5 mb-4">Bienvenido</h1>

        <form method="POST">
            <input type="submit"
                   value="Cerrar Sesión"
                   asp-page-handler="BtClose"
                   class="btn btn-danger px-4" />
        </form>
    </div>
}
