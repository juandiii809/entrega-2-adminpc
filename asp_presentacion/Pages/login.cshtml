@page
@model loginModel
@{
    ViewData["Title"] = "login";
}

<h1>Iniciar Sesión</h1>
<hr />

<div class="row justify-content-center">
    <div class="col-md-5">

        <h2>@ViewData["Title"]</h2>
        <hr />

        <form method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Input.Usuario"></label>
                <input asp-for="Input.Usuario" class="form-control" />
                <span asp-validation-for="Input.Usuario" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Contraseña"></label>
                <input asp-for="Input.Contraseña" class="form-control" type="password" />
                <span asp-validation-for="Input.Contraseña" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Iniciar Sesión</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}